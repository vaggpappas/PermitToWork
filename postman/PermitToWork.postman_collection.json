                "api",
                "employees",
                "{{employeeId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nadia\",\n  \"lastName\": \"Kowalski\",\n  \"email\": \"nadia.kowalski@acme.example\",\n  \"phoneNumber\": \"+30 210 555 0199\",\n  \"jobTitle\": \"Senior Welder\",\n  \"tradeId\": \"{{tradeId}}\",\n  \"dateOfBirth\": \"1990-08-03\",\n  \"address\": {\n    \"street\": \"12 Pireos Street\",\n    \"city\": \"Athens\",\n    \"postalCode\": \"10553\",\n    \"country\": \"Greece\"\n  }\n}"
