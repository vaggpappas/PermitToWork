    {
      "name": "7. Company scoping",
      "description": "The part worth showing off. Requires folder 6 to have run.",
      "item": [
        {
          "name": "Contractor sees only her own company",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{contractorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Uses the token from registration instead of the administrator's. The EF global query filter narrows every row, with no company check written in any controller."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('sees at least herself', () => pm.expect(page.totalCount).to.be.above(0));",
                  "pm.test('sees nobody from another company', () => {",
                  "  const others = page.items.filter(i => i.companyName !== 'Acme Maintenance Services');",
                  "  pm.expect(others, JSON.stringify(others)).to.be.empty;",
                  "});",
                  "pm.test('the administrator is hidden from her', () => {",
                  "  const admins = page.items.filter(i => i.email === 'admin@permittowork.local');",
                  "  pm.expect(admins).to.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Contractor cannot create employees",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{contractorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"ACME-0043\",\n  \"firstName\": \"Nadia\",\n  \"lastName\": \"Kowalski\",\n  \"email\": \"x@acme.example\",\n  \"phoneNumber\": \"+30 210 555 0142\",\n  \"companyId\": \"{{companyId}}\",\n  \"tradeId\": \"{{tradeId}}\",\n  \"jobTitle\": \"Welder\",\n  \"hireDate\": \"2021-04-12\",\n  \"dateOfBirth\": \"1990-08-03\",\n  \"address\": {\n    \"street\": \"12 Pireos Street\",\n    \"city\": \"Athens\",\n    \"postalCode\": \"10553\",\n    \"country\": \"Greece\"\n  }\n}"
            },
