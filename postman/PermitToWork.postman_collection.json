          ]
        }
      ]
    },
    {
      "name": "5. Business rules (the interesting part)",
      "description": "Each of these proves a rule lives in the domain rather than in a controller.",
      "item": [
        {
          "name": "Reinstate someone who is already active",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}/reinstate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}",
                "reinstate"
              ]
            },
            "description": "The controller contains no status logic at all. Employee.Reinstate() refuses, and the exception handler turns that into 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('explains the rule', () =>",
                  "  pm.expect(pm.response.json().detail).to.include('Only a suspended employee'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suspend them",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
