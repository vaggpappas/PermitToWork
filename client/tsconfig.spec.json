/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    // Test-only helpers. Included so they are type-checked with the specs rather than
    // silently untyped, and kept out of tsconfig.app.json so they can never reach the
    // production bundle.
    "src/testing/**/*.ts"
  ]
}
