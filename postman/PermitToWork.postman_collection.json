        {
          "name": "An employee cannot manage themselves",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}/manager",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}",
                "manager"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"managerId\": \"{{employeeId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('explains the rule', () =>",
