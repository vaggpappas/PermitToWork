  "item": [
    {
      "name": "1. Smoke test",
      "description": "Run these first. If Health fails, nothing else will work.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "No token needed. Proves the API is up before anything else is blamed.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is up', () => pm.response.to.have.status(200));",
                  "pm.test('reports healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Employees without a token is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "Every endpoint except health, register and login requires a bearer token.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication",
      "description": "Log in first. The token is reused by every request below.",
      "item": [
        {
          "name": "Login as administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Seeded on first startup. The test script stores the token in a collection variable, so every later request authenticates automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@permittowork.local\",\n  \"password\": \"Admin!23456\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "console.log('Token stored. Expires ' + body.expiresAtUtc);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "The message must be the same as for an unknown email, so this endpoint cannot be used to find out who has an account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@permittowork.local\",\n  \"password\": \"definitely-wrong\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('message does not reveal whether the account exists', () =>",
                  "  pm.expect(pm.response.json().detail).to.eql('Invalid email or password.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Confirms the token carries the roles and the company scope you expect."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.test('administrator sees every company', () => pm.expect(me.scope).to.eql('all companies'));",
                  "pm.test('has the Administrator role', () => pm.expect(me.roles).to.include('Administrator'));"
                ]
              }
            }
          ]
        }
      ]
    },
