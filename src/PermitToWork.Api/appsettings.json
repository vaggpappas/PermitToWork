{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PermitToWorkDb": "Server=localhost,1433;Database=PermitToWork;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "PermitToWork.Api",
    "Audience": "PermitToWork.Client",
    "AccessTokenLifetimeMinutes": 60
  },
  "Storage": {
    "//": "Where permit attachments are written. Relative paths resolve next to the binary.",
    "DocumentRoot": "uploads"
  },
  "PermitExpiry": {
    "//": "How often the background sweep looks for permits whose validity has passed.",
    "IntervalMinutes": 15
  }
}
