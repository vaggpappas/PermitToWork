        {
          "name": "Reject a malformed email",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            },
            "description": "Caught by DataAnnotations at the edge, before the request reaches the service.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nadia\",\n  \"lastName\": \"Kowalski\",\n  \"email\": \"not-an-email\",\n  \"jobTitle\": \"Senior Welder\",\n  \"tradeId\": \"{{tradeId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
