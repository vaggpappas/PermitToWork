            "description": "PageRequest clamps instead of rejecting, so there is no 'invalid page' error to handle anywhere."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('clamped to 100', () => pm.expect(pm.response.json().pageSize).to.eql(100));"
                ]
              }
