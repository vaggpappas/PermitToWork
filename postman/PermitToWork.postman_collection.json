    {
      "name": "4. Employees",
      "description": "Create, read, search, update.",
      "item": [
        {
          "name": "Create an employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "Administrators only. The badge number and employer decide what this person can later see, so they are not self-asserted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"ACME-0042\",\n  \"firstName\": \"Nadia\",\n  \"lastName\": \"Kowalski\",\n  \"email\": \"nadia.kowalski@acme.example\",\n  \"phoneNumber\": \"+30 210 555 0142\",\n  \"companyId\": \"{{companyId}}\",\n  \"tradeId\": \"{{tradeId}}\",\n  \"jobTitle\": \"Welder\",\n  \"hireDate\": \"2021-04-12\",\n  \"dateOfBirth\": \"1990-08-03\",\n  \"address\": {\n    \"street\": \"12 Pireos Street\",\n    \"city\": \"Athens\",\n    \"postalCode\": \"10553\",\n    \"country\": \"Greece\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const created = pm.response.json();",
                  "pm.collectionVariables.set('employeeId', created.id);",
                  "pm.test('Location header points at the new record', () =>",
                  "  pm.expect(pm.response.headers.get('Location')).to.include(created.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create the same badge number again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "Must be a clean 409, not a 500 from the unique index.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"ACME-0042\",\n  \"firstName\": \"Nadia\",\n  \"lastName\": \"Kowalski\",\n  \"email\": \"someone.else@acme.example\",\n  \"phoneNumber\": \"+30 210 555 0142\",\n  \"companyId\": \"{{companyId}}\",\n  \"tradeId\": \"{{tradeId}}\",\n  \"jobTitle\": \"Welder\",\n  \"hireDate\": \"2021-04-12\",\n  \"dateOfBirth\": \"1990-08-03\",\n  \"address\": {\n    \"street\": \"12 Pireos Street\",\n    \"city\": \"Athens\",\n    \"postalCode\": \"10553\",\n    \"country\": \"Greece\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('says which value clashed', () =>",
                  "  pm.expect(pm.response.json().detail).to.include('ACME-0042'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            },
            "description": "Age is computed from the date of birth on every read, never stored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const e = pm.response.json();",
                  "pm.test('full name is derived', () => pm.expect(e.fullName).to.eql('Nadia Kowalski'));",
                  "pm.test('age is computed, not stored', () => pm.expect(e.age).to.be.a('number'));",
                  "pm.test('starts Active', () => pm.expect(e.status).to.eql('Active'));",
                  "pm.test('has no account until they register', () => pm.expect(e.hasAccount).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=Kowalski&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Kowalski"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('finds her', () => pm.expect(page.totalCount).to.be.above(0));",
                  "pm.test('paging metadata is present', () => pm.expect(page).to.have.property('totalPages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by badge number",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=ACME-0042",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "ACME-0042"
                }
              ]
            },
            "description": "The badge number is stored through a value converter, so it is matched exactly rather than with LIKE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('exactly one match', () => pm.expect(pm.response.json().totalCount).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Oversized page size is clamped",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?pageSize=100000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "100000"
                }
              ]
